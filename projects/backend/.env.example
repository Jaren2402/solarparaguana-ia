# Servidor
PORT=18512
NODE_ENV=development

# Base de datos (requerida para cotizar con stock local de Coro / Punto Fijo)
MONGO_URI=mongodb://127.0.0.1:27017/solarparaguana_ia

# Bot de Telegram (opcional: sin token el bot se desactiva y el servidor sigue activo)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Token para /microservices/telegram/mcp/tools (opcional)
MCP_SERVICE_TOKEN=
